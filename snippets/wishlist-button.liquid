{%- if settings.wishlist_snippet != blank -%}
  <div class="heart heart--app">{{ settings.wishlist_snippet | replace: '{PRODUCT_ID}', product.id | replace: '{PRODUCT_HANDLE}', product.handle | replace: '{PRODUCT_URL}', product.url }}</div>
{%- else -%}
  <button type="button" class="heart" data-wish data-handle="{{ product.handle }}" aria-pressed="false" aria-label="Save {{ product.title | escape }} to wishlist"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg></button>
{%- endif -%}
