{%- assign th = settings.free_shipping_threshold | times: 100 -%}
{%- if th > 0 -%}
  {%- assign left = th | minus: cart.total_price -%}
  <div class="ship">
    <p>{% if left > 0 %}Add {{ left | money }} more for free shipping{% else %}You have free shipping{% endif %}</p>
    <div class="ship__bar"><i style="width:{{ cart.total_price | times: 100 | divided_by: th | at_most: 100 }}%"></i></div>
  </div>
{%- endif -%}
