{%- paginate search.results by 16 -%}
<section class="wrap block">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="{{ routes.root_url }}">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">Search</li></ol></nav>
  <div class="page-head"><p class="collection-hero__eyebrow">18STICHES</p><h1>{% if search.performed and search.terms != blank %}Search results{% else %}Find something you love{% endif %}</h1></div>
  {% render 'predictive-search-form', id: 'SearchPage', value: search.terms %}
  {%- if search.performed -%}
    <p class="muted search-results__count">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>
    {%- if search.results_count > 0 -%}<div class="grid search-results-grid">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}{%- endfor -%}</div>{%- endif -%}
    {%- if search.results_count == 0 -%}<p class="empty">Nothing found. Try a different word.</p>{%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{"name":"Search page","settings":[]}
{% endschema %}
