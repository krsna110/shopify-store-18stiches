<section class="wrap block brand-story{% if section.settings.bg_color == 'mist' %} brand-story--mist{% elsif section.settings.bg_color == 'dark' %} brand-story--dark{% endif %}" {{ section.shopify_attributes }}>
  <div class="brand-story__container{% if section.settings.image != blank %} brand-story__container--split{% else %} brand-story__container--centered{% endif %}">
    {%- if section.settings.image != blank -%}
      <div class="brand-story__visual">
        <div class="brand-story__frame">
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'brand-story__img', alt: section.settings.heading }}
          {%- if section.settings.badge_text != blank -%}
            <span class="brand-story__seal">{{ section.settings.badge_text }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="brand-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.quote != blank -%}
        <blockquote class="brand-story__quote">
          “{{ section.settings.quote }}”
        </blockquote>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="brand-story__body rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.signature != blank -%}
        <div class="brand-story__signature">
          <span>{{ section.settings.signature }}</span>
          {%- if section.settings.signature_sub != blank -%}
            <small>{{ section.settings.signature_sub }}</small>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="brand-story__cta">
          <a class="btn {% if section.settings.bg_color == 'dark' %}btn--ghost{% endif %}" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story & Heritage",
  "settings": [
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background Tone",
      "options": [
        {"value": "paper", "label": "Pure White"},
        {"value": "mist", "label": "Soft Mist Blush"},
        {"value": "dark", "label": "Midnight Plum"}
      ],
      "default": "paper"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Heritage / Artisan Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Seal / Badge Text",
      "default": "Handcrafted in India"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE PHILOSOPHY OF 18 STITCHES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where Heirloom Craft Meets Contemporary Silhouettes"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Poetic Quote / Manifesto",
      "default": "Every stitch carries an intention. A tribute to the Indian artisan, handloom weaving, and the quiet grace of timeless slow fashion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Narrative Body",
      "default": "<p>18 Stitches was founded on a simple conviction: luxury should feel soulful, effortless, and deeply grounded in heritage. Born out of reverence for India's indigenous textile traditions—from luminous hand-spun Chanderis to intricate zardozi needlework—each garment is created in small, limited capsules.</p><p>We believe clothing should not just be worn for a season, but cherished across celebrations and passed down as an heirloom.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature / Founder Name",
      "default": "The 18 Stitches Atelier"
    },
    {
      "type": "text",
      "id": "signature_sub",
      "label": "Signature Subtitle",
      "default": "Curated with Precision & Soul"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore The Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Brand Story & Heritage"
    }
  ]
}
{% endschema %}

