{%- if section.settings.image != blank -%}
  <section class="editorial-banner" aria-label="{{ section.settings.heading | escape }}" {{ section.shopify_attributes }}>
    <picture class="editorial-banner__media">
      {%- if section.settings.mobile_image != blank -%}<source media="(max-width: 700px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{%- endif -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '900, 1400, 1800, 2200', sizes: '100vw', alt: section.settings.image.alt | default: section.settings.heading }}
    </picture>
    {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
      <div class="editorial-banner__content">
        {%- if section.settings.eyebrow != blank -%}<p class="editorial-banner__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.link != blank -%}<a class="btn" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}
{% schema %}
{"name":"Editorial image banner","settings":[
 {"type":"image_picker","id":"image","label":"Desktop campaign image"},
 {"type":"image_picker","id":"mobile_image","label":"Mobile campaign image"},
 {"type":"text","id":"eyebrow","label":"Small label"},
 {"type":"text","id":"heading","label":"Heading","default":"Made for the moments in between."},
 {"type":"textarea","id":"text","label":"Text"},
 {"type":"text","id":"button_label","label":"Button label"},
 {"type":"url","id":"link","label":"Button link"}
],"presets":[{"name":"Editorial image banner"}]}
{% endschema %}
