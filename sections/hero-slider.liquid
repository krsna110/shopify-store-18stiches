<section class="slider" data-slider>
  <div class="slider__track" data-slider-track>
    {%- for block in section.blocks -%}
      <div class="slide{% if block.settings.image == blank %} slide--text-only{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <picture class="slide__picture">
            {%- if block.settings.image_mobile != blank -%}<source media="(max-width: 700px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">{%- endif -%}
            {%- assign loading = 'lazy' -%}{%- assign priority = 'auto' -%}{%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- assign priority = 'high' -%}{%- endif -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: loading: loading, fetchpriority: priority, widths: '900, 1400, 1800, 2400', sizes: '100vw', alt: block.settings.image.alt | default: block.settings.heading }}
          </picture>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <div class="slide__text">
            {%- if forloop.first -%}<h1>{{ block.settings.heading }}</h1>{%- else -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}<a class="btn" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button class="slider__btn slider__btn--prev" type="button" data-prev aria-label="Previous slide">‹</button>
    <button class="slider__btn slider__btn--next" type="button" data-next aria-label="Next slide">›</button>
  {%- endif -%}
</section>
{% schema %}
{"name":"Banner slider","max_blocks":6,"settings":[],
 "blocks":[{"type":"slide","name":"Slide","settings":[
  {"type":"image_picker","id":"image","label":"Desktop image (wide)"},
  {"type":"image_picker","id":"image_mobile","label":"Mobile image (portrait)"},
 {"type":"text","id":"heading","label":"Heading","info":"Use editable text here rather than baking copy into the image."},
  {"type":"text","id":"text","label":"Text"},
  {"type":"text","id":"button_label","label":"Button label","default":"Explore collection"},
  {"type":"url","id":"link","label":"Link"}]}],
 "presets":[{"name":"Banner slider","blocks":[{"type":"slide"}]}]}
{% endschema %}
