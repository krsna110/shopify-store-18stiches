<section class="wrap block lookbook-section" {{ section.shopify_attributes }}>
  <div class="center lookbook__header">
    {%- if section.settings.eyebrow != blank -%}<p class="lookbook__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="muted narrow center">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <div class="lookbook__grid">
    {%- for block in section.blocks -%}
      <div class="lookbook-item lookbook-item--{{ block.settings.layout }}" {{ block.shopify_attributes }}>
        <div class="lookbook-item__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'lookbook-item__img', alt: block.settings.caption }}
          {%- else -%}
            {%- assign p_index = forloop.index | modulo: 6 | plus: 1 -%}
            {{ 'collection-' | append: p_index | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <div class="lookbook-item__overlay">
          <div class="lookbook-item__details">
            {%- if block.settings.look_num != blank -%}
              <span class="lookbook-item__num">{{ block.settings.look_num }}</span>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <h3 class="lookbook-item__title">{{ block.settings.caption }}</h3>
            {%- endif -%}
            {%- if block.settings.fabric != blank -%}
              <p class="lookbook-item__fabric">{{ block.settings.fabric }}</p>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a class="btn btn--ghost lookbook-item__btn" href="{{ block.settings.link }}">
                {{ block.settings.btn_label | default: 'Shop This Look' }} &rarr;
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CAMPAIGN VOL. 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Heritage Edit Lookbook"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A visual poetry of woven textures, rich jewel tones, and contemporary Indian ease."
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Lookbook Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Campaign Image"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Card Size / Span",
          "options": [
            {"value": "tall", "label": "Portrait Tall (3:4)"},
            {"value": "wide", "label": "Landscape Wide (16:9)"},
            {"value": "square", "label": "Square (1:1)"}
          ],
          "default": "tall"
        },
        {
          "type": "text",
          "id": "look_num",
          "label": "Look Number",
          "default": "LOOK 01"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Silhouette Title",
          "default": "Hand-embroidered Chanderi Kurta Set"
        },
        {
          "type": "text",
          "id": "fabric",
          "label": "Fabric & Craft",
          "default": "Pure Chanderi Silk with Antique Zari Borders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product / Collection Link"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Shop This Look"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Lookbook",
      "blocks": [
        {
          "type": "look",
          "settings": {
            "look_num": "LOOK 01",
            "caption": "Gulabi Chanderi Angrakha Set",
            "fabric": "Handwoven Chanderi with gota patti detailing",
            "layout": "tall"
          }
        },
        {
          "type": "look",
          "settings": {
            "look_num": "LOOK 02",
            "caption": "Kashmir Night Velvet Co-ord",
            "fabric": "Micro-velvet with delicate zardozi cuffs",
            "layout": "tall"
          }
        },
        {
          "type": "look",
          "settings": {
            "look_num": "LOOK 03",
            "caption": "Mogra Raw Silk Anarkali",
            "fabric": "Raw Mulberry Silk with organza scalloped dupatta",
            "layout": "wide"
          }
        }
      ]
    }
  ]
}
{% endschema %}
