<section class="wrap trust">
  {%- for block in section.blocks -%}<div class="trust__item" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>{%- endfor -%}
</section>
{% schema %}
{"name":"Service strip","max_blocks":4,"settings":[],
 "blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"title","label":"Title","default":"Title"},{"type":"text","id":"text","label":"Text"}]}],
 "presets":[{"name":"Service strip","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}
