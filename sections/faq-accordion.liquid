<section class="wrap block faq-section" {{ section.shopify_attributes }}>
  <div class="center faq__header">
    {%- if section.settings.eyebrow != blank -%}<p class="faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading | escape }}</h1>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="muted narrow center">{{ section.settings.subheading | escape }}</p>{%- endif -%}
  </div>
  <div class="faq__body narrow">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category_heading' -%}
        <h2 class="faq__cat-title" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</h2>
      {%- elsif block.type == 'faq_item' and block.settings.question != blank and block.settings.answer != blank -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-item__question"><span>{{ block.settings.question | escape }}</span><span class="faq-item__icon" aria-hidden="true">+</span></summary>
          <div class="faq-item__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- assign contact_page = section.settings.contact_page | default: pages.contact -%}
  {%- if contact_page != blank or settings.whatsapp_number != blank -%}
    <div class="center faq__footer"><p class="muted">{{ section.settings.footer_text | escape }}</p>
      {%- if contact_page != blank -%}<a class="btn btn--ghost" href="{{ contact_page.url }}">{{ section.settings.contact_label | escape }}</a>
      {%- elsif settings.whatsapp_number != blank -%}<a class="btn btn--ghost" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{{ section.settings.contact_label | escape }}</a>{%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name":"18STICHES FAQ",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"HELP & CLIENT CARE"},
    {"type":"text","id":"heading","label":"Heading","default":"Frequently Asked Questions"},
    {"type":"textarea","id":"subheading","label":"Introduction","default":"Answers to common questions about products and shopping with 18STICHES."},
    {"type":"text","id":"footer_text","label":"Contact prompt","default":"Need more help? Get in touch with 18STICHES."},
    {"type":"text","id":"contact_label","label":"Contact button label","default":"CONTACT US"},
    {"type":"page","id":"contact_page","label":"Contact page"}
  ],
  "blocks":[
    {"type":"category_heading","name":"FAQ category","settings":[{"type":"text","id":"title","label":"Category name","default":"Orders"}]},
    {"type":"faq_item","name":"Question and answer","settings":[
      {"type":"text","id":"question","label":"Question","default":"Add a customer question"},
      {"type":"richtext","id":"answer","label":"Answer","default":"<p>Add confirmed information for customers here.</p>"}
    ]}
  ],
  "presets":[{"name":"18STICHES FAQ","blocks":[
    {"type":"category_heading","settings":{"title":"Orders"}},
    {"type":"faq_item","settings":{"question":"Where can I find information about my order?","answer":"<p>For help with an order, contact us and include your order number.</p>"}},
    {"type":"category_heading","settings":{"title":"Payments"}},
    {"type":"faq_item","settings":{"question":"Which payment methods are available?","answer":"<p>The payment methods available for your order are shown during checkout.</p>"}},
    {"type":"category_heading","settings":{"title":"Sizes and product information"}},
    {"type":"faq_item","settings":{"question":"How do I choose a size?","answer":"<p>Check the size information on the product page. If you need help selecting an option, contact us before ordering.</p>"}},
    {"type":"faq_item","settings":{"question":"Where can I find product fabric and care details?","answer":"<p>Refer to the details listed on the product page. If a detail is not shown, contact us to ask about that item.</p>"}},
    {"type":"category_heading","settings":{"title":"Shipping"}},
    {"type":"faq_item","settings":{"question":"Where can I find shipping costs and delivery information?","answer":"<p>Review the shipping information shown during checkout and the Shipping Policy page for the current details.</p>"}},
    {"type":"category_heading","settings":{"title":"Returns and refunds"}},
    {"type":"faq_item","settings":{"question":"How can I request a return or refund?","answer":"<p>Please read the Return and Refund Policy page for current eligibility and instructions. Contact us if you have a question about your order.</p>"}},
    {"type":"category_heading","settings":{"title":"Order tracking"}},
    {"type":"faq_item","settings":{"question":"How can I get help tracking an order?","answer":"<p>Contact us with your order number and we can help you find the available order status information.</p>"}}
  ]}]
}
{% endschema %}
