<section class="wrap block">
  <div class="block__head"><h2>{{ section.settings.heading }}</h2></div>
  <div class="tiles tiles--{{ section.settings.shape }}">
    {%- for block in section.blocks -%}
      {%- assign n = forloop.index | modulo: 6 | plus: 1 -%}
      <a class="tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        <span class="tile__img">{%- if block.settings.image -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 900px) 16vw, 34vw' }}{%- else -%}{{ 'collection-' | append: n | placeholder_svg_tag: 'placeholder' }}{%- endif -%}</span>
        <span class="tile__name">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Image tiles","max_blocks":12,
 "settings":[
  {"type":"text","id":"heading","label":"Heading","default":"Top categories"},
  {"type":"select","id":"shape","label":"Tile shape","options":[{"value":"rect","label":"Portrait rectangle"},{"value":"round","label":"Circle"},{"value":"arch","label":"Arch (Indian window shape)"}],"default":"rect"}],
 "blocks":[{"type":"tile","name":"Tile","settings":[
  {"type":"image_picker","id":"image","label":"Image"},
  {"type":"text","id":"title","label":"Title","default":"Category"},
  {"type":"url","id":"link","label":"Link"}]}],
 "presets":[{"name":"Image tiles","blocks":[{"type":"tile"},{"type":"tile"},{"type":"tile"},{"type":"tile"}]}]}
{% endschema %}
