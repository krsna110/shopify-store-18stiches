<section class="wrap block">
  <div class="page-head"><h1>Collections</h1></div>
  <div class="grid">
    {%- for collection in collections -%}
      <a class="card" href="{{ collection.url }}"><div class="card__media">{%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'card__img' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'card__img placeholder' }}{%- endif -%}</div><div class="card__body"><span class="card__title">{{ collection.title }}</span></div></a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Collections list","settings":[]}
{% endschema %}
