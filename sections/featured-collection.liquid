{%- if section.settings.collection != blank -%}
<section class="wrap block">
  <div class="block__head"><h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.collection != blank -%}<a class="link" href="{{ section.settings.collection.url }}">View all</a>{%- endif -%}
  </div>
  <div class="grid{% if section.settings.layout == 'slider' %} grid--slider{% endif %}">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.count -%}{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}{%- endfor -%}
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Featured collection","settings":[
 {"type":"text","id":"heading","label":"Heading","default":"Bestsellers"},
 {"type":"collection","id":"collection","label":"Collection"},
 {"type":"select","id":"layout","label":"Layout","options":[{"value":"grid","label":"Grid"},{"value":"slider","label":"Scrolling row"}],"default":"grid"},
 {"type":"range","id":"count","label":"Products to show","min":4,"max":12,"step":2,"default":8},
 {"type":"checkbox","id":"show_quick_add","label":"Show quick add","default":true}
],"presets":[{"name":"Featured collection"}]}
{% endschema %}
