<section class="wrap block size-guide-section" data-size-guide {{ section.shopify_attributes }}>
  <div class="center size-guide__head">
    {%- if section.settings.eyebrow != blank -%}<p class="size-guide__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="muted narrow center">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <div class="size-guide__controls">
    <div class="size-guide__unit-toggle" role="group" aria-label="Measurement Units">
      <button type="button" class="unit-btn is-active" data-unit="in">Inches (in)</button>
      <button type="button" class="unit-btn" data-unit="cm">Centimeters (cm)</button>
    </div>
  </div>

  <div class="size-guide__table-wrap">
    <table class="size-table" data-unit-view="in">
      <thead>
        <tr>
          <th>Size</th>
          <th>India / Standard</th>
          <th>Bust</th>
          <th>Waist</th>
          <th>Hips</th>
          <th>Kurta / Dress Length</th>
          <th>Shoulder</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>XS</strong></td>
          <td>32</td>
          <td data-in="32 - 33" data-cm="81 - 84">32 - 33</td>
          <td data-in="26 - 27" data-cm="66 - 69">26 - 27</td>
          <td data-in="35 - 36" data-cm="89 - 91">35 - 36</td>
          <td data-in="46" data-cm="117">46</td>
          <td data-in="13.5" data-cm="34">13.5</td>
        </tr>
        <tr>
          <td><strong>S</strong></td>
          <td>34</td>
          <td data-in="34 - 35" data-cm="86 - 89">34 - 35</td>
          <td data-in="28 - 29" data-cm="71 - 74">28 - 29</td>
          <td data-in="37 - 38" data-cm="94 - 97">37 - 38</td>
          <td data-in="46" data-cm="117">46</td>
          <td data-in="14" data-cm="35.5">14</td>
        </tr>
        <tr>
          <td><strong>M</strong></td>
          <td>36</td>
          <td data-in="36 - 37" data-cm="91 - 94">36 - 37</td>
          <td data-in="30 - 31" data-cm="76 - 79">30 - 31</td>
          <td data-in="39 - 40" data-cm="99 - 102">39 - 40</td>
          <td data-in="46" data-cm="117">46</td>
          <td data-in="14.5" data-cm="37">14.5</td>
        </tr>
        <tr>
          <td><strong>L</strong></td>
          <td>38</td>
          <td data-in="38 - 39" data-cm="97 - 99">38 - 39</td>
          <td data-in="32 - 33" data-cm="81 - 84">32 - 33</td>
          <td data-in="41 - 42" data-cm="104 - 107">41 - 42</td>
          <td data-in="47" data-cm="119">47</td>
          <td data-in="15" data-cm="38">15</td>
        </tr>
        <tr>
          <td><strong>XL</strong></td>
          <td>40</td>
          <td data-in="40 - 41" data-cm="102 - 104">40 - 41</td>
          <td data-in="34 - 35" data-cm="86 - 89">34 - 35</td>
          <td data-in="43 - 44" data-cm="109 - 112">43 - 44</td>
          <td data-in="47" data-cm="119">47</td>
          <td data-in="15.5" data-cm="39.5">15.5</td>
        </tr>
        <tr>
          <td><strong>XXL</strong></td>
          <td>42</td>
          <td data-in="42 - 43" data-cm="107 - 109">42 - 43</td>
          <td data-in="36 - 37" data-cm="91 - 94">36 - 37</td>
          <td data-in="45 - 46" data-cm="114 - 117">45 - 46</td>
          <td data-in="47" data-cm="119">47</td>
          <td data-in="16" data-cm="40.5">16</td>
        </tr>
        <tr>
          <td><strong>3XL</strong></td>
          <td>44</td>
          <td data-in="44 - 45" data-cm="112 - 114">44 - 45</td>
          <td data-in="38 - 39" data-cm="97 - 99">38 - 39</td>
          <td data-in="47 - 48" data-cm="119 - 122">47 - 48</td>
          <td data-in="47" data-cm="119">47</td>
          <td data-in="16.5" data-cm="42">16.5</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="size-guide__notes-grid">
    <div class="size-card">
      <div class="size-card__head">
        <span class="size-card__num">01</span>
        <h4>How to Measure Correctly</h4>
      </div>
      <ul class="size-card__list">
        <li><strong>Bust:</strong> Measure around the fullest part of your bust holding the tape comfortably loose.</li>
        <li><strong>Waist:</strong> Measure around your natural waistline, keeping one finger between tape and body.</li>
        <li><strong>Hips:</strong> Stand with feet together and measure around the widest part of your hips.</li>
        <li><strong>Kurta Length:</strong> Measured vertically from the high shoulder point to the hemline.</li>
      </ul>
    </div>

    <div class="size-card size-card--bespoke">
      <div class="size-card__head">
        <span class="size-card__num">02</span>
        <h4>Custom Fit & WhatsApp Concierge</h4>
      </div>
      <p>All 18 Stitches garments are tailored with <strong>2 to 3 inches of inner margin</strong> so you can comfortably alter them if your silhouette changes.</p>
      <p>Need a customized sleeve length, neckline, or made-to-measure sizing?</p>
      {%- if settings.whatsapp_number != blank -%}
        <a class="btn btn--block" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ 'Hi 18 Stitches, I need custom sizing assistance for an order.' | url_encode }}" target="_blank" rel="noopener">
          WhatsApp Styling Concierge &rarr;
        </a>
      {%- else -%}
        <a class="btn btn--block" href="/pages/contact">
          Request Bespoke Sizing &rarr;
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size & Fit Guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRECISION TAILORING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size & Silhouette Guide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Measurements listed are body measurements in inches. If you are between sizes, we recommend sizing up for Indian ethnic wear."
    }
  ],
  "presets": [
    {"name": "Size & Fit Guide"}
  ]
}
{% endschema %}
