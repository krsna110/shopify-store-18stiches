<div class="search-drawer" id="SearchDrawer" aria-hidden="true" data-search-drawer>
  <button class="search-drawer__veil" type="button" data-search-close aria-label="Close search"></button>
  <section class="search-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="SearchDrawerTitle" tabindex="-1">
    <div class="search-drawer__head"><p id="SearchDrawerTitle">Find something you love</p><button class="icon-btn" type="button" data-search-close aria-label="Close search">&times;</button></div>
    {% render 'predictive-search-form', id: 'SearchDrawer' %}
  </section>
</div>
{% schema %}
{"name":"Search drawer","settings":[]}
{% endschema %}
