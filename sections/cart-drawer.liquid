<div class="drawer" id="CartDrawer" aria-hidden="true">
  <div class="drawer__veil" data-cart-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping bag">
    <div id="CartDrawerInner" class="drawer__inner">
      <div class="drawer__head">
        <h2>Your bag ({{ cart.item_count }})</h2>
        <button class="icon-btn drawer__close" type="button" data-cart-close aria-label="Close bag"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m5 5 14 14M19 5 5 19"/></svg></button>
      </div>
      <p class="cart-loading" data-cart-loading role="status" aria-live="polite" hidden>Updating your bag…</p>
      <p class="cart-message" data-cart-error role="status" aria-live="polite" hidden></p>
      {%- if cart.item_count == 0 -%}
        <div class="drawer__empty"><p class="drawer__empty-eyebrow">18STICHES</p><h3>Your bag is waiting.</h3><p>Discover a piece for your everyday moments.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>
      {%- else -%}
        {% render 'shipping-progress' %}
        <ul class="drawer__items">
          {%- for item in cart.items -%}
            <li class="line">
              <a class="line__img" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 80 }}{% endif %}</a>
              <div class="line__info">
                <a href="{{ item.url }}" class="line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<ul class="line__options">{%- for option in item.options_with_values -%}<li><span>{{ option.name }}:</span> {{ option.value }}</li>{%- endfor -%}</ul>{%- endunless -%}
                <div class="qty">
                  <button type="button" data-qty data-line="{{ forloop.index }}" data-value="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
                  <span aria-live="polite">{{ item.quantity }}</span>
                  <button type="button" data-qty data-line="{{ forloop.index }}" data-value="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
                </div>
              </div>
              <div class="line__price">{% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<strong>{{ item.final_line_price | money }}</strong><button type="button" class="link" data-qty data-line="{{ forloop.index }}" data-value="0" aria-label="Remove {{ item.product.title | escape }}">Remove</button></div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="drawer__foot">
          {%- if cart.cart_level_discount_applications.size > 0 -%}<ul class="cart-discounts">{%- for discount in cart.cart_level_discount_applications -%}<li>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></li>{%- endfor -%}</ul>{%- endif -%}
          <form class="discount-form" data-discount-form>
            <label for="DrawerDiscount">Discount code</label>
            <div><input id="DrawerDiscount" name="discount_code" type="text" autocomplete="off" placeholder="Enter code" required><button class="btn btn--ghost" type="submit">Apply</button></div>
            <p data-discount-message role="status" aria-live="polite"></p>
          </form>
          <p class="row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></p>
          <p class="muted">Taxes, discounts and shipping are confirmed at checkout.</p>
          <form action="{{ routes.cart_url }}" method="post"><button class="btn btn--block" type="submit" name="checkout">Checkout</button></form>
          <a class="link" href="{{ routes.cart_url }}">View full bag</a>
          <a class="link drawer__continue" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
        </div>
      {%- endif -%}
    </div>
  </aside>
</div>
{% schema %}
{"name":"Cart drawer","settings":[]}
{% endschema %}
