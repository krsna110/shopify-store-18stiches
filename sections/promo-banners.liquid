<section class="wrap block">
  <div class="banners">
    {%- for block in section.blocks -%}
      <a class="banner" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 900px) 50vw, 100vw' }}{%- else -%}{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
        <span class="banner__text"><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Two promo banners","max_blocks":2,"settings":[],
 "blocks":[{"type":"banner","name":"Banner","settings":[
  {"type":"image_picker","id":"image","label":"Image"},
  {"type":"text","id":"title","label":"Title","default":"Festive collection"},
  {"type":"text","id":"text","label":"Text"},
  {"type":"url","id":"link","label":"Link"}]}],
 "presets":[{"name":"Two promo banners","blocks":[{"type":"banner"},{"type":"banner"}]}]}
{% endschema %}
