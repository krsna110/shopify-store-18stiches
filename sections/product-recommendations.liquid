<section class="wrap block">
  <div class="block__head"><h2>{{ section.settings.heading }}</h2></div>
  <div class="grid" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for product in recommendations.products -%}{% render 'product-card', product: product %}{%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Related products","settings":[{"type":"text","id":"heading","label":"Heading","default":"You may also like"}]}
{% endschema %}
