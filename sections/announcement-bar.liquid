{%- if section.settings.text != blank -%}
<div class="announce">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}<span>{{ section.settings.text }}</span>{%- endif -%}
</div>
{%- endif -%}
{% schema %}
{"name":"Announcement bar","settings":[
 {"type":"text","id":"text","label":"Message","default":"Free shipping above ₹1,999. Extra 10% off on prepaid orders."},
 {"type":"url","id":"link","label":"Link"}
]}
{% endschema %}
