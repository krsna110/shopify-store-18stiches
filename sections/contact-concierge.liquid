<section class="wrap block contact-page" {{ section.shopify_attributes }}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="{{ routes.root_url }}">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">{{ page.title | escape }}</li></ol></nav>
  <header class="contact-page__intro">
    <p class="about-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading | escape }}</p>{%- endif -%}
  </header>
  <div class="contact-page__grid">
    <aside class="contact-page__details" aria-label="Contact information">
      {%- if section.settings.contact_note != blank -%}<div class="rte">{{ section.settings.contact_note }}</div>{%- endif -%}
      {%- if section.settings.email != blank -%}<div class="contact-page__detail"><h2>Email</h2><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></div>{%- endif -%}
      {%- if section.settings.phone != blank -%}<div class="contact-page__detail"><h2>Phone</h2><a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | escape }}">{{ section.settings.phone | escape }}</a></div>{%- endif -%}
      {%- if section.settings.address != blank -%}<div class="contact-page__detail"><h2>Business address</h2><p>{{ section.settings.address | escape | newline_to_br }}</p></div>{%- endif -%}
      {%- assign has_social_links = false -%}
      {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_youtube != blank -%}{%- assign has_social_links = true -%}{%- endif -%}
      {%- if has_social_links -%}
        <div class="contact-page__detail"><h2>Follow 18STICHES</h2><ul class="contact-page__social">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram | escape }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook | escape }}" rel="noopener" target="_blank">Facebook</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube | escape }}" rel="noopener" target="_blank">YouTube</a></li>{%- endif -%}
        </ul></div>
      {%- endif -%}
    </aside>
    <div class="contact-page__form-wrap">
      <h2>Send us a message</h2>
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}<p class="contact-form__success" role="status" tabindex="-1">{{ section.settings.success_message | escape }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="contact-form__error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="contact-form__row">
          <div><label for="ContactName-{{ section.id }}">Name</label><input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div>
          <div><label for="ContactEmail-{{ section.id }}">Email</label><input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></div>
        </div>
        <div class="contact-form__row">
          <div><label for="ContactPhone-{{ section.id }}">Phone <span>(optional)</span></label><input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}"></div>
          <div><label for="ContactSubject-{{ section.id }}">Subject</label><input id="ContactSubject-{{ section.id }}" type="text" name="contact[subject]" value="{{ form.subject | escape }}" required></div>
        </div>
        <div><label for="ContactMessage-{{ section.id }}">Message</label><textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea></div>
        <button class="btn" type="submit">Send message</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Contact 18STICHES",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CONTACT 18STICHES"},
    {"type":"text","id":"heading","label":"Heading","default":"How can we help?"},
    {"type":"textarea","id":"subheading","label":"Introduction","default":"For questions about an order or our collections, send us a message below."},
    {"type":"richtext","id":"contact_note","label":"Contact information note"},
    {"type":"text","id":"email","label":"Business email","default":""},
    {"type":"text","id":"phone","label":"Business phone","default":""},
    {"type":"textarea","id":"address","label":"Business address","default":""},
    {"type":"text","id":"success_message","label":"Form success message","default":"Thank you for your message."}
  ],
  "presets":[{"name":"Contact 18STICHES"}]
}
{% endschema %}
