<section class="wrap block concierge-section" {{ section.shopify_attributes }}>
  <div class="concierge__grid">
    <div class="concierge__info">
      <p class="concierge__eyebrow">{{ section.settings.eyebrow | default: 'ATELIER ASSISTANCE' }}</p>
      <h2>{{ section.settings.heading | default: 'Personal Styling & Client Concierge' }}</h2>
      <p class="concierge__lead muted">{{ section.settings.subheading | default: 'Whether you require assistance with sizing, festive gifting, or custom handcrafted silhouettes, our atelier team is here to assist you.' }}</p>

      <div class="concierge__channel-card">
        <div class="concierge__channel-head">
          <span class="concierge__icon">💬</span>
          <div>
            <h4>Instant WhatsApp Assistance</h4>
            <p>Direct access to our senior stylist & sizing consultant.</p>
          </div>
        </div>
        {%- if settings.whatsapp_number != blank -%}
          <a class="btn btn--block" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ 'Hi 18 Stitches, I would love styling assistance.' | url_encode }}" target="_blank" rel="noopener">
            Chat on WhatsApp
          </a>
        {%- else -%}
          <a class="btn btn--block" href="#ContactForm">
            Send an Inquiry
          </a>
        {%- endif -%}
      </div>

      <div class="concierge__details">
        <div class="concierge__item">
          <strong>Atelier Hours</strong>
          <span>Monday – Saturday: 10:00 AM – 7:00 PM IST</span>
        </div>
        <div class="concierge__item">
          <strong>Email Inquiries</strong>
          <span><a class="link" href="mailto:{{ section.settings.email | default: 'concierge@18stitches.com' }}">{{ section.settings.email | default: 'concierge@18stitches.com' }}</a></span>
        </div>
        <div class="concierge__item">
          <strong>Studio Location</strong>
          <span>{{ section.settings.address | default: '18 Stitches Design House, New Delhi / Jaipur, India' }}</span>
        </div>
      </div>
    </div>

    <div class="concierge__form-wrap">
      <div class="concierge__form-card">
        <h3>Send an Inquiry</h3>
        <p class="muted">Fill out the form below and our stylist will respond within 24 hours.</p>

        {%- form 'contact', id: 'ContactForm', class: 'concierge-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="note" style="color: green; font-weight: 500;">Thank you for reaching out. An atelier stylist will be in touch shortly.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="note note--err">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <div class="form-row">
            <div>
              <label for="ContactName">Your Name</label>
              <input type="text" id="ContactName" name="contact[name]" placeholder="Full Name" required>
            </div>
            <div>
              <label for="ContactPhone">Phone / WhatsApp</label>
              <input type="tel" id="ContactPhone" name="contact[phone]" placeholder="+91 98765 43210">
            </div>
          </div>

          <div>
            <label for="ContactEmail">Email Address</label>
            <input type="email" id="ContactEmail" name="contact[email]" placeholder="you@example.com" required>
          </div>

          <div>
            <label for="ContactReason">Inquiry Nature</label>
            <select id="ContactReason" name="contact[inquiry_type]">
              <option value="Sizing & Fit Consultation">Sizing & Custom Measurements</option>
              <option value="Festive / Wedding Order">Occasion / Festive Styling</option>
              <option value="Order Tracking & Delivery">Order Status & Delivery</option>
              <option value="General Inquiries">Other Inquiries</option>
            </select>
          </div>

          <div>
            <label for="ContactMessage">Message or Measurements</label>
            <textarea id="ContactMessage" name="contact[body]" rows="5" placeholder="Share your sizing requirements, preferred silhouette, or question..." required></textarea>
          </div>

          <button class="btn btn--block" type="submit">Submit Request</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Concierge & Contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ATELIER ASSISTANCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personal Styling & Client Concierge"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Whether you require assistance with sizing, festive gifting, or custom handcrafted silhouettes, our atelier team is here to assist you."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Concierge Email",
      "default": "concierge@18stitches.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Studio Address / City",
      "default": "18 Stitches Design House, New Delhi / Jaipur, India"
    }
  ],
  "presets": [
    {"name": "Concierge & Contact"}
  ]
}
{% endschema %}
