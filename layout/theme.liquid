<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_dark }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if page_image -%}<meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">{%- endif -%}
  {%- assign fh = settings.font_heading | default: 'Cormorant Garamond' | strip | replace: ' ', '+' -%}
  {%- assign fb = settings.font_body | default: 'DM Sans' | strip | replace: ' ', '+' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ fh }}&family={{ fb }}:wght@400;500;600&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{--ink:{{ settings.color_ink | default: '#292725' }};--paper:{{ settings.color_paper | default: '#F8F3ED' }};--accent:{{ settings.color_accent | default: '#713D46' }};--gold:{{ settings.color_gold | default: '#B99B7B' }};--mist:{{ settings.color_mist | default: '#D9B7B1' }};--dark:{{ settings.color_dark | default: '#343A32' }};--wine:#713D46;--rose:#D9B7B1;--sand:#B99B7B;--olive:#343A32;--charcoal:#292725;--white:#FFFFFF;--hd:'{{ settings.font_heading | default: 'Cormorant Garamond' }}',Georgia,serif;--bd:'{{ settings.font_body | default: 'DM Sans' }}',system-ui,sans-serif}
  </style>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handleize }}">
  <a class="skip" href="#Main">Skip to content</a>
  {% sections 'header-group' %}
  <main id="Main" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% section 'cart-drawer' %}
  {% section 'search-drawer' %}
  <script>window.theme={routes:{root:{{ routes.root_url | json }},cart:{{ routes.cart_url | json }},cart_add:{{ routes.cart_add_url | json }},cart_change:{{ routes.cart_change_url | json }},predictive_search:{{ routes.predictive_search_url | json }}},money:{{ shop.money_format | json }}};</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
