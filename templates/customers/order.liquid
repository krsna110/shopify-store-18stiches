<section class="wrap block customer-page customer-order-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="{{ routes.root_url }}">Home</a></li><li aria-hidden="true">/</li><li><a href="{{ routes.account_url }}">My account</a></li><li aria-hidden="true">/</li><li aria-current="page">{{ order.name | escape }}</li></ol></nav>
  <header class="customer-page__head customer-page__head--row"><div><p class="about-editorial__eyebrow">ORDER DETAILS</p><h1>{{ order.name | escape }}</h1><p>Placed {{ order.created_at | time_tag: format: 'date' }}</p></div><a class="btn btn--ghost" href="{{ routes.account_url }}">Back to orders</a></header>
  <div class="customer-order__summary">
    <div><span>Payment</span><strong>{{ order.financial_status_label | escape }}</strong></div>
    {%- if order.fulfillment_status_label != blank -%}<div><span>Fulfillment</span><strong>{{ order.fulfillment_status_label | escape }}</strong></div>{%- endif -%}
    <div><span>Total</span><strong>{{ order.total_price | money }}</strong></div>
    {%- if order.order_status_url != blank -%}<a class="link" href="{{ order.order_status_url }}">View Shopify order status</a>{%- endif -%}
  </div>
  <section class="customer-order__items"><h2>Items</h2><ul class="customer-order__list">
    {%- for item in order.line_items -%}
      <li class="customer-order__item">
        {%- if item.image -%}<a class="customer-order__image" href="{{ item.product.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '80px', alt: item.title }}</a>{%- endif -%}
        <div><h3>{{ item.title | escape }}</h3>{%- unless item.product.has_only_default_variant -%}<ul class="line__options">{%- for option in item.options_with_values -%}<li><span>{{ option.name | escape }}:</span> {{ option.value | escape }}</li>{%- endfor -%}</ul>{%- endunless -%}<p>Quantity: {{ item.quantity }}</p></div>
        <strong>{{ item.final_line_price | money }}</strong>
      </li>
    {%- endfor -%}
  </ul></section>
  {%- if order.fulfillments.size > 0 -%}
    <section class="customer-tracking"><h2>Shipment tracking</h2>
      {%- for fulfillment in order.fulfillments -%}
        {%- if fulfillment.tracking_url != blank or fulfillment.tracking_number != blank -%}
          <div class="customer-tracking__item">
            {%- if fulfillment.tracking_company != blank -%}<p>{{ fulfillment.tracking_company | escape }}</p>{%- endif -%}
            {%- if fulfillment.tracking_number != blank -%}<p>Tracking number: <span>{{ fulfillment.tracking_number | escape }}</span></p>{%- endif -%}
            {%- if fulfillment.tracking_url != blank -%}<a class="btn btn--ghost" href="{{ fulfillment.tracking_url }}">Track shipment</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if order.order_status_url != blank -%}<a class="link" href="{{ order.order_status_url }}">View Shopify order status</a>{%- endif -%}
    </section>
  {%- endif -%}
  <div class="customer-order__addresses">
    {%- if order.shipping_address -%}<section><h2>Shipping address</h2><address>{{ order.shipping_address | format_address }}</address></section>{%- endif -%}
    {%- if order.billing_address -%}<section><h2>Billing address</h2><address>{{ order.billing_address | format_address }}</address></section>{%- endif -%}
  </div>
</section>
