<section class="wrap block customer-page customer-auth">
  <header class="customer-page__head"><p class="about-editorial__eyebrow">18STICHES ACCOUNT</p><h1>Choose a new password</h1><p>Enter and confirm your new password.</p></header>
  <section class="customer-panel customer-panel--narrow">
    {%- form 'reset_customer_password', class: 'customer-form' -%}
      {%- if form.errors -%}<div class="customer-form__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div><label for="ResetPassword">New password</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div><label for="ResetPasswordConfirm">Confirm new password</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn" type="submit">Reset password</button>
    {%- endform -%}
  </section>
</section>
